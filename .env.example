# Copy to .env (git-ignored) and set a local-only password. Do not commit real values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Password for the non-owner app_user role the API connects as. Local-only, never commit.
APP_USER_PASSWORD=
# Password for the identity_reader role behind ConnectionStrings:Identity (login lookup only; no table access).
# Local-only, never commit. Use a different value from APP_USER_PASSWORD.
IDENTITY_USER_PASSWORD=
POSTGRES_DB=mtra
POSTGRES_PORT=5432
